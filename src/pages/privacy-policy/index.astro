---
import BaseLayout from "../layouts/BaseLayout.astro";
import { en } from "../i18n/en";
---

<BaseLayout title={`${en.privacy.title} — ${en.site.title}`}>
  <main
    class="mx-auto flex min-h-dvh w-full max-w-3xl flex-col justify-center gap-6 px-[clamp(1.5rem,6vw,5rem)] py-32"
  >
    <h1 class="text-title font-extrabold uppercase">{en.privacy.title}</h1>
    <p class="text-body text-muted">{en.privacy.pending}</p>
    <a
      href="/"
      class="w-fit text-body font-bold text-ink underline underline-offset-4 transition-colors duration-200 hover:text-muted"
    >
      {en.privacy.backLabel}
    </a>
  </main>
</BaseLayout>
