---
import { en } from "../i18n/en";
---

<header class="fixed top-0 right-0 z-10 animate-rise" style="animation-delay: 0.15s">
  <nav
    class="flex gap-2 p-[clamp(1.25rem,4vw,2.5rem)] sm:gap-3"
    aria-label={en.nav.primaryAria}
  >
    <a
      href="/projects"
      class="rounded-full border border-line px-4 py-2 text-[clamp(0.85rem,2vw,1rem)] font-bold lowercase tracking-wide text-ink transition-colors duration-200 hover:bg-ink hover:text-bg focus-visible:bg-ink focus-visible:text-bg focus-visible:outline-none sm:px-5 sm:py-2.5"
      aria-label={en.nav.projectsAria}
    >
      {en.nav.projects}
    </a>
    <a
      href="mailto:simosultan2020@gmail.com"
      class="rounded-full border border-line px-4 py-2 text-[clamp(0.85rem,2vw,1rem)] font-bold lowercase tracking-wide text-ink transition-colors duration-200 hover:bg-ink hover:text-bg focus-visible:bg-ink focus-visible:text-bg focus-visible:outline-none sm:px-5 sm:py-2.5"
      aria-label={en.nav.contactAria}
    >
      {en.nav.contact}
    </a>
  </nav>
</header>
